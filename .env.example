# Copy to .env locally. Never commit real values.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
ONEBOT_ACCESS_TOKEN=
ALLOWED_QQ_USERS=
DAILY_LIMIT=100
# Companion behavior switches. 0 disables input batching; false disables splitting.
MERGE_WINDOW_MS=900
MERGE_MAX_WAIT_MS=3000
SPLIT_ENABLED=true
SEND_GAP_MS=500
